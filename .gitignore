.env

# Derived data stays out of git: raw filings (~200MB), extracted sections, and
# the Chroma index are all reproducible from `python -m scripts.build_index`.
# The golden dataset is the exception — it is hand-curated ground truth, the
# measuring instrument for the whole eval harness, and must be diffable in
# review. Note `data/*` rather than `data/`: git will not descend into an
# excluded directory, so the negation below only works with the wildcard form.
data/*
!data/golden/

sec-edgar-filings/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Claude Code: personal, per-machine files
CLAUDE.local.md
.claude/settings.local.json
