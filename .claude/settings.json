{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(python -m scripts.validate_golden)",
      "Bash(python -m scripts.validate_golden *)",
      "Bash(python -m scripts.corpus_search *)",
      "Bash(python -m scripts.ask *)",
      "Bash(python -m compileall *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(python -m scripts.build_index)",
      "Bash(python -m scripts.build_index *)",
      "Edit(./data/golden/questions.jsonl)",
      "Write(./data/golden/questions.jsonl)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_claude_attribution.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_golden_on_edit.py\""
          }
        ]
      }
    ]
  }
}
