# Copy this to .env and fill in your values.

# Required for embeddings
OPENAI_API_KEY=sk-...

# Required for generation (also used as paid-judge fallback in Weeks 3+)
ANTHROPIC_API_KEY=sk-ant-...

# Required for the eval judge (Weeks 3+). Free tier is fine.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Required by SEC EDGAR — they require a user-agent identifying you.
# Format: "Your Name your.email@example.com"
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"
